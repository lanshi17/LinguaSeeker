mineru_local_model_id: {{ mineru.local_model_id }}
mineru_local_timeout: {{ mineru.local_timeout }}
mineru_local_dpi: {{ mineru.local_dpi }}

# ── Model Server ────────────────────────────────────────────────────────
model_server_url: http://{{ app.api_host if app.api_host != '0.0.0.0' else 'localhost' }}:{{ model_server.port }}

# ── Redis ───────────────────────────────────────────────────────────────
redis_host: {{ redis.host }}
