# 数据库配置
POSTGRES_DB=acmg_ps3                 # PostgreSQL 数据库名称
POSTGRES_USER=yangzs                  # PostgreSQL 用户名
POSTGRES_PASSWORD=***REMOVED***    # PostgreSQL 密码，请修改为强密码

# Redis 配置
REDIS_PASSWORD=redis_password         # Redis 访问密码，请修改为强密码

# Neo4j 配置
NEO4J_USER=neo4j                      # Neo4j 用户名
NEO4J_PASSWORD=***REMOVED***        # Neo4j 密码，请修改为强密码

# Qdrant 配置
QDRANT_API_KEY=qdrant_api_key         # Qdrant API 密钥，请修改为强密钥
QDRANT_HOST=localhost                 # Qdrant 主机地址
QDRANT_PORT=6333                      # Qdrant HTTP 端口
QDRANT_GRPC_PORT=6334                 # Qdrant gRPC 端口
QDRANT_COLLECTION_NAME=paper_chunks   # Qdrant 集合名称
QDRANT_DIMENSION=1536                 # 向量维度
QDRANT_USE_TLS=true                   # 是否使用TLS连接
QDRANT_VERIFY_SSL=true                # 是否验证SSL证书
QDRANT_ENABLE_TLS=true                # 是否在Qdrant服务端启用TLS

# MinIO 配置
MINIO_ROOT_USER=yangzs                # MinIO 管理员用户名
MINIO_ROOT_PASSWORD=***REMOVED***  # MinIO 管理员密码