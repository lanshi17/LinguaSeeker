# ==================== PostgreSQL配置 (远程) ====================
POSTGRES_HOST="db.postgres.example.com"
POSTGRES_PORT="5432"
POSTGRES_DB="acmg_ps3"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-secure-postgres-password"
POSTGRES_POOL_SIZE="20"
POSTGRES_MAX_OVERFLOW="30"

# ==================== Neo4j配置 (远程) ====================
NEO4J_URI="bolt://neo4j.example.com:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your-secure-neo4j-password"
NEO4J_DATABASE="neo4j"
NEO4J_MAX_CONNECTION_LIFETIME="3600"
NEO4J_MAX_CONNECTION_POOL_SIZE="50"

# ==================== 向量数据库选择 ====================
VECTOR_DB="qdrant"

# ==================== Qdrant配置 (远程) ====================
QDRANT_HOST="qdrant.example.com"
QDRANT_PORT="6333"
QDRANT_COLLECTION_NAME="paper_chunks"
QDRANT_DIMENSION="1536"
QDRANT_PREFER_GRPC="true"

# ==================== Milvus配置 (可选，备用) ====================
MILVUS_HOST="milvus.example.com"
MILVUS_PORT="19530"
MILVUS_COLLECTION_NAME="paper_chunks"
MILVUS_DIMENSION="1536"
MILVUS_INDEX_TYPE="IVF_FLAT"
MILVUS_METRIC_TYPE="L2"

# ==================== MinIO配置 (远程存储，启用TLS) ====================
MINIO_ENDPOINT="minio.example.com:9000"
MINIO_ACCESS_KEY="your-minio-access-key"
MINIO_SECRET_KEY="your-minio-secret-key"
MINIO_BUCKET_NAME="acmg-documents"
MINIO_SECURE="true"

# ==================== 任务配置 ====================
MAX_REASONING_ITERATIONS="3"
TASK_TIMEOUT_SECONDS="3600"

