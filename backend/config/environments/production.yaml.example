# ============================================================================
# Production Environment Configuration
# ============================================================================
# Copy to production.yaml and customize for your production deployment.
# Secrets go in vault/production.yaml (git-ignored)
# ============================================================================

# -- Application -------------------------------------------------------------
environment: "production"
debug: false
cors_origins: "https://your-domain.com"

# -- LLM Endpoints (Production) ----------------------------------------------
fast_llm:
  base_url: "https://api.production-llm.com/v1"

reasoning_llm:
  base_url: "https://api.production-llm.com/v1"

chat_llm:
  base_url: "https://api.production-llm.com"

translation_llm:
  base_url: "https://api.production-llm.com"

# -- Inference Services (Production — multi-container mode) ------------------
embedding:
  base_url: "http://embedding-server:8002/v1"
  remote_base_url: "https://api.production-embedding.com"
  remote_model: "Qwen/Qwen3-Embedding-0.6B"

rerank:
  base_url: "http://rerank-server:8003/v1"
  remote_base_url: "https://api.production-rerank.com"
  remote_model: "BAAI/bge-reranker-v2-m3"

# -- Database Connections (Production) ----------------------------------------
postgres:
  host: "postgres-server"
  db: "lingua_seeker"
  schema: "acmg_app"

redis:
  host: "redis-server"

# -- Literature Acquisition ---------------------------------------------------
unpaywall:
  email: "admin@your-domain.com"

# -- Network / Proxy ---------------------------------------------------------
network:
  proxy: ""
  no_proxy: "cn,ncbi.nlm.nih.gov,nlm.nih.gov,unpaywall.org,localhost,127.0.0.1"

# -- Inference Service GPU Settings (Production — multi-container) -----------
doc_parse_model_id: "opendatalab/MinerU2.5-Pro-2604-1.2B"
