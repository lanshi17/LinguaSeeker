# ============================================================================
# Production Environment Configuration
# ============================================================================
# Copy to production.yaml and customize for your production deployment.
# Secrets go in vault/production.yaml (git-ignored)
# ============================================================================

# ── Application ───────────────────────────────────────────────────────────
environment: "production"
debug: false
cors_origins: "https://your-domain.com"

# ── LLM Endpoints (Production) ──────────────────────────────────────────
fast_llm:
  base_url: "https://api.production-llm.com/v1"

multimodal_llm:
  enabled: false
  base_url: "https://api.production-llm.com/v1"

reasoning_llm:
  base_url: "https://api.production-llm.com/v1"

# ── Model Server (Production) ────────────────────────────────────────────
embedding:
  base_url: "http://model-server:8001/v1"

rerank:
  base_url: "http://model-server:8001/v1"

mineru:
  api_url: "https://mineru.net/api/v4"
  local_model_server_url: "http://model-server:8001"

# ── Database Connections (Production) ────────────────────────────────────
postgres:
  host: "postgres-server"
  db: "acmg_lingua"
  schema: "acmg_app"

redis:
  host: "redis-server"
  password: ""

neo4j:
  uri: "bolt://neo4j-server:7687"
  user: "neo4j"
  database: "neo4j"

# ── Object Storage (Production) ──────────────────────────────────────────
minio:
  endpoint: "minio-server:9000"
  secure: true

# ── Network / Proxy ──────────────────────────────────────────────────────
network:
  proxy: ""
  no_proxy: "cn,ncbi.nlm.nih.gov,nlm.nih.gov,unpaywall.org,localhost,127.0.0.1"

# ── Literature Acquisition ────────────────────────────────────────────────
jstage_proxy: ""
