# Lingua Seeker backend host — GPU15 (furong.genemed.tech)
# ============================================================================
# Split-host topology: the SPA lives on a SEPARATE frontend host
# (genemed.tech) which serves dist at /linguaseeker and proxies
# /linguaseeker/api/ here. This host exposes ONLY the API + health.
#
# This host is a pure passthrough: the frontend host injects X-API-Key
# (it holds the shared secret), nginx forwards it unchanged to the backend.
# Direct browser hits to /api/ without the key are rejected by the backend's
# require_api_key guard, so the backend stays protected even though this host
# is internet-facing.
#
# Required vars: backend_domain_name, backend_port
# ============================================================================
#
# HTTP → HTTPS redirect + ACME
server {
    listen 80;
    server_name {{ backend_domain_name }};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

upstream backend {
    server 127.0.0.1:{{ backend_port }};
    keepalive 32;
}

server {
    listen 443 ssl http2;
    server_name {{ backend_domain_name }};

    ssl_certificate     /etc/letsencrypt/live/{{ backend_domain_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ backend_domain_name }}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;

    # ── API → Backend (passthrough; X-API-Key injected by frontend host) ────
    location /api/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # X-API-Key is NOT set here — it is forwarded from the frontend host.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;            # SSE / chunked friendly
    }

    # ── Health check (public liveness probe, no auth) ─────────────────────
    location /health {
        proxy_pass http://backend;
        access_log off;
    }
}
