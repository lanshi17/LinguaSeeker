# Neo4j 环境变量配置
# 使用 NEO4J_AUTH 设置认证信息（格式：username/password）
NEO4J_AUTH=neo4j/***REMOVED***

# 代理绕过设置
NO_PROXY=localhost,127.0.0.1,10.0.0.0/8,192.168.0.0/16,.local
no_proxy=localhost,127.0.0.1,10.0.0.0/8,192.168.0.0/16,.local

# 内存设置
NEO4J_server_memory_heap_max__size=1G
NEO4J_server_memory_pagecache_size=512M
