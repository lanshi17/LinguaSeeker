{# ============================================================================
   Rendered Configuration Template
   ============================================================================
   This Jinja2 template merges layered variables (defaults → environment →
   vault) into the flat key format expected by backend/src/core/config.py.
   
   Render via: scripts/render_config.py or the config loader in config.py
   Output:     backend/config-dev.yaml (git-ignored) or stdout
   ============================================================================ #}
# Auto-generated configuration — DO NOT EDIT MANUALLY
# Generated from: defaults/main.yaml + environments/{{ environment }}.yaml + vault/{{ environment }}.yaml
# Regenerate with: uv run python scripts/render_config.py --env {{ environment }}

# ── App ──────────────────────────────────────────────────────────────────
app_name: {{ app.name }}
app_version: "{{ app.version }}"
api_prefix: {{ app.api_prefix }}
cors_origins: "{{ app.cors_origins }}"
environment: {{ app.environment }}
debug: {{ app.debug | lower }}
api_host: {{ app.api_host }}
api_port: {{ app.api_port }}

# ── Fast LLM (OpenAI-compatible) ────────────────────────────────────────
fast_llm_api_key: {{ fast_llm.api_key }}
fast_llm_base_url: {{ fast_llm.base_url }}
fast_llm_model: {{ fast_llm.model }}
fast_llm_temperature: {{ fast_llm.temperature }}
fast_llm_max_tokens: {{ fast_llm.max_tokens }}
fast_llm_timeout: {{ fast_llm.timeout }}
fast_llm_max_retries: {{ fast_llm.max_retries }}

# ── Multimodal LLM ──────────────────────────────────────────────────────
multimodal_llm_enabled: {{ multimodal_llm.enabled | lower }}
multimodal_llm_api_key: {{ multimodal_llm.api_key }}
multimodal_llm_base_url: {{ multimodal_llm.base_url }}
multimodal_llm_model: {{ multimodal_llm.model }}

# ── Reasoning LLM ───────────────────────────────────────────────────────
reasoning_llm_api_key: {{ reasoning_llm.api_key }}
reasoning_llm_model: {{ reasoning_llm.model }}
reasoning_llm_reasoning_effort: {{ reasoning_llm.reasoning_effort }}
reasoning_llm_base_url: {{ reasoning_llm.base_url }}
reasoning_llm_temperature: {{ reasoning_llm.temperature }}
reasoning_llm_max_tokens: {{ reasoning_llm.max_tokens }}
reasoning_llm_timeout: {{ reasoning_llm.timeout }}
reasoning_llm_max_retries: {{ reasoning_llm.max_retries }}

# ── Embedding (local model-server) ──────────────────────────────────────
