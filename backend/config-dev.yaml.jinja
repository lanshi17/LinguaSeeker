# Local development configuration for ACMG-Lingua backend.
# =========================================================
# This file is loaded by config.py BEFORE pydantic-settings reads env vars.
# YAML values become the baseline; env vars / .env.local override them.
#
# Usage:
#   1. Copy backend/.env.example to backend/.env.local
#   2. Fill secrets there (API keys, passwords)
#   3. Edit this file for non-secret structural config (models, hosts, etc.)
#
# Do NOT commit this file with real secrets — it is git-ignored.

# ── App ──────────────────────────────────────────────────────────────────
app_name: {{ app_name }}
app_version: "{{ app_version }}"
api_prefix: /api/v1
cors_origins: "*"
environment: development
debug: false
api_host: localhost
api_port: 8000

# ── Fast LLM (OpenAI-compatible) ────────────────────────────────────────
fast_llm_api_key: your-fast-llm-api-key
fast_llm_base_url: https://api.xiaomimimo.com/v1
fast_llm_model: mimo-v2.5
fast_llm_temperature: 0
fast_llm_max_tokens: 8192
fast_llm_timeout: 180
fast_llm_max_retries: 3

# ── Multimodal LLM (disabled by default) ────────────────────────────────
multimodal_llm_enabled: false
multimodal_llm_api_key: your-multimodal-llm-api-key
multimodal_llm_base_url: https://api.xiaomimimo.com/v1
multimodal_llm_model: mimo-v2.5

# ── Reasoning LLM ───────────────────────────────────────────────────────
reasoning_llm_api_key: your-reasoning-api-key
reasoning_llm_model: mimo-v2.5-pro
reasoning_llm_reasoning_effort: xhigh
reasoning_llm_base_url: https://api.xiaomimimo.com/v1
reasoning_llm_temperature: 0.0
reasoning_llm_max_tokens: 8192
reasoning_llm_timeout: 300
reasoning_llm_max_retries: 3

# ── Embedding (local model-server) ──────────────────────────────────────
embedding_base_url: http://localhost:8001/v1
embedding_model: Qwen/Qwen3-Embedding-0.6B
embedding_dimension: 1024
embedding_batch_size: 10

# ── Rerank (local model-server) ─────────────────────────────────────────
rerank_base_url: http://localhost:8001/v1
rerank_model: bge-reranker-v2-m3
rerank_top_k: 10
rerank_score_threshold: 0.7

# ── MinerU document parsing ─────────────────────────────────────────────
mineru_api_url: https://mineru.net/api/v4
mineru_api_token: your-mineru-api-token
mineru_api_token_backup: your-mineru-backup-api-token
mineru_version: vlm
mineru_download_dir: /tmp/mineru_downloads
mineru_timeout: 300
mineru_max_file_size_mb: 100

# ── Parse Document (MinerU local/remote) ────────────────────────────────
mineru_remote_api_token: ""
mineru_remote_poll_interval: 2.0
mineru_remote_max_poll_attempts: 150
mineru_local_model_server_url: http://localhost:8001
mineru_local_model_id: opendatalab/MinerU2.5-Pro-2604-1.2B
mineru_local_timeout: 120.0
mineru_local_dpi: 200

# ── Model Server ────────────────────────────────────────────────────────
model_server_url: http://localhost:8001

# ── Redis ───────────────────────────────────────────────────────────────
redis_host: localhost
redis_port: 6379
redis_password: ""
redis_db: 0
redis_max_connections: 20

# ── PostgreSQL ──────────────────────────────────────────────────────────
postgres_host: 127.0.0.1
postgres_port: 5432
postgres_db: {{ postgres_db }}
postgres_schema: {{ postgres_schema }}
postgres_user: your-postgres-user
postgres_password: your-postgres-password
postgres_pool_size: 20
postgres_max_overflow: 30
pgvector_enabled: true

# ── Neo4j ───────────────────────────────────────────────────────────────
neo4j_uri: bolt://localhost:7687
neo4j_user: neo4j
neo4j_password: your-neo4j-password
neo4j_database: neo4j
neo4j_max_connection_lifetime: 3600
neo4j_max_connection_pool_size: 50

# ── MinIO ───────────────────────────────────────────────────────────────
minio_endpoint: localhost:9000
minio_access_key: your-minio-access-key
minio_secret_key: your-minio-secret-key
minio_api: s3v4
minio_path: auto
minio_bucket_name: acmg-bucket
minio_secure: false
minio_root_user: your-minio-root-user
minio_root_password: your-minio-root-password

# ── Task execution ──────────────────────────────────────────────────────
max_reasoning_iterations: 3
task_timeout_seconds: 3600

# ── Literature acquisition ──────────────────────────────────────────────
pubmed_api_key: your-pubmed-api-key
pubmed_base_url: https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi
unpaywall_email: your-email@example.com
jstage_proxy: http://127.0.0.1:7890

# ── SMTP ────────────────────────────────────────────────────────────────
smtp_host: smtp.exmail.qq.com
smtp_port: 465
smtp_user: your-smtp-user
smtp_password: your-smtp-password
smtp_from_email: your-email@example.com

# ── Web Search (Firecrawl) ──────────────────────────────────────────────
WEB_SEARCH_API_KEY: your-web-search-api-key
WEB_SEARCH_BASE_URL: https://api.firecrawl.dev
WEB_SEARCH_TIMEOUT: 30
WEB_SEARCH_MAX_RESULTS: 10

# ── Model Server GPU settings (read by model-server, not backend) ───────
vlm_model_id: ""
embedding_gpu_memory_utilization: 0.35
embedding_max_model_len: 4096
rerank_gpu_memory_utilization: 0.20
vlm_gpu_memory_utilization: 0.50
