# Backend host environment — copy to .env, fill in secrets, never commit.
#
# Cross-host wiring lives here. The frontend host reaches this machine on
# BACKEND_PORT; the inference services are reached from the backend
# via *_BASE_URL variables below.


# ── Image / network ──────────────────────────────────────────────────────
# Override BACKEND_IMAGE if pulling from a custom registry path.
# IMAGE_TAG selects which build to run; the GitHub Actions deploy workflow
# passes this through automatically.
BACKEND_IMAGE=lingua-seeker-backend
IMAGE_TAG=latest
BACKEND_BIND=0.0.0.0
BACKEND_PORT=8000

# ── CORS / auth ──────────────────────────────────────────────────────────
# Must include the public origin the browser sees, e.g. https://app.example.com
CORS_ORIGINS=https://app.example.com
# Shared with the frontend nginx (deploy/compose/frontend-host/.env::API_KEY).
API_KEY=change-me-to-a-long-random-string

# ── Postgres ─────────────────────────────────────────────────────────────
POSTGRES_DB=lingua_seeker
POSTGRES_USER=lingua_seeker
POSTGRES_PASSWORD=change-me
POSTGRES_SCHEMA=lingua

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── Inference service / LLM endpoints ──────────────────────────────────────
# Either remote SaaS or your GPU host. Use private IPs when possible.
EMBEDDING_BASE_URL=http://10.0.0.30:32949
RERANK_BASE_URL=http://10.0.0.30:35001
FAST_LLM_BASE_URL=https://api.siliconflow.cn/v1
REASONING_LLM_BASE_URL=https://api.siliconflow.cn/v1
