# Auto-generated by Ansible — DO NOT EDIT MANUALLY
# Secrets — injected from Ansible Vault at deploy time

session_signing_key: "{{ vault_session_signing_key }}"

fast_llm:
  api_key: "{{ vault_fast_llm_api_key }}"

reasoning_llm:
  api_key: "{{ vault_reasoning_llm_api_key }}"

mineru:
  api_token: "{{ vault_mineru_api_token }}"

web_search:
  firecrawl_api_key: "{{ vault_web_search_firecrawl_api_key }}"
  tavily_api_key: "{{ vault_web_search_tavily_api_key | default('') }}"
  tavily_search_depth: "{{ web_search_tavily_search_depth | default('basic') }}"
  serpapi_api_key: "{{ vault_web_search_serpapi_api_key | default('') }}"
  serpapi_engine: "{{ web_search_serpapi_engine | default('google') }}"

# ── Literature Acquisition API Keys ──────────────────────────────────────
#   PUBMED_API_KEY -> NCBI E-utilities (3→10 req/s); applies to pmc + pubmed_service
#   BASE_API_KEY   -> BASE (Bielefeld Academic Search Engine)
#   CORE_API_KEY   -> CORE (core.ac.uk)
pubmed:
  api_key: "{{ vault_pubmed_api_key }}"

base:
  api_key: "{{ vault_base_api_key }}"

core:
  api_key: "{{ vault_core_api_key }}"

postgres:
  user: "{{ postgres_user }}"
  password: "{{ vault_postgres_password }}"

redis:
  password: "{{ vault_redis_password }}"
