# ============================================================================
# Development Secrets Template
# ============================================================================
# Copy to development.yaml and fill in your actual credentials.
# This file is git-ignored — NEVER commit real secrets.
# ============================================================================

# ── LLM API Keys ──────────────────────────────────────────────────────────
fast_llm:
  api_key: "your-fast-llm-api-key"

reasoning_llm:
  api_key: "your-reasoning-api-key"

# ── MinerU API Tokens ────────────────────────────────────────────────────
mineru_api_token: "your-mineru-api-token"
mineru_api_token_backup: ""
mineru_remote_api_token: "your-mineru-remote-api-token"

# ── Database Credentials ─────────────────────────────────────────────────
postgres:
  user: "your-postgres-user"
  password: "your-postgres-password"

redis:
  password: ""

# ── Web Search ────────────────────────────────────────────────────────────
web_search:
  api_key: "your-web-search-api-key"
