# Auto-rendered at container start from environment variables.
# Variables: BACKEND_URL, API_KEY, FRONTEND_MAX_BODY, BASE_PATH.
#
# BASE_PATH: SPA mount path, no trailing slash.
#   "" or "/"  → root mount (dist served at /, API at /api/).
#   "/linguaseeker" → subpath mount (dist at /linguaseeker/, API at /linguaseeker/api/).
#
# The SPA MUST be built with VITE_BASE_PATH matching BASE_PATH so index.html
# references /<base>/assets/... and API/health URLs derive from the Vite base.
#
# entrypoint.sh normalizes BASE_PATH to "" (root) or "/<seg>" (subpath) before
# envsubst, so ${BASE_PATH} interpolates cleanly into location prefixes:
#   root:     location /assets/   |  subpath:  location /linguaseeker/assets/
#
# Static files: dist is laid out as dist/assets/... and dist/index.html (no
# BASE_PATH nesting on disk). The assets location uses `alias` to strip the
# BASE_PATH prefix; the SPA fallback rewrites to the root index.html.

server {
    listen       80;
    server_name  _;

    client_max_body_size ${FRONTEND_MAX_BODY};

    root /usr/share/nginx/html;
    index index.html;

    # ── Long-cache fingerprinted assets emitted by Vite ─────────────
    # alias maps the URL prefix to the on-disk assets dir (no BASE_PATH nest).
    location ${BASE_PATH}/assets/ {
        alias /usr/share/nginx/html/assets/;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # ── API → backend server (cross-host) ───────────────────────────
    # X-API-Key is injected here; the browser never sees it.
    # proxy_pass with a URI suffix rewrites the matched location prefix,
    # so /linguaseeker/api/v1/... → ${BACKEND_URL}/api/v1/...
    location ${BASE_PATH}/api/ {
        proxy_pass         ${BACKEND_URL}/api/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-API-Key         ${API_KEY};
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering    off;            # SSE / chunked friendly
    }

    # ── Health check → backend (public liveness, no auth) ───────────
    location = ${BASE_PATH}/health {
        proxy_pass         ${BACKEND_URL}/health;
        access_log         off;
    }

    # ── SPA fallback ────────────────────────────────────────────────
    # Serve index.html for any path under BASE_PATH that isn't a static file.
    # `rewrite ... break` strips the BASE_PATH prefix in-place (no re-match,
    # so no loop) so try_files resolves against root — dist has no BASE_PATH
    # nesting on disk. At root mount BASE_PATH is "" so the rewrite is a no-op
    # and this single block handles both topologies.
    location ${BASE_PATH}/ {
        rewrite ^${BASE_PATH}/(.*)$ /$1 break;
        try_files $uri $uri/ /index.html;
    }

    # Redirect bare BASE_PATH (no trailing slash) to BASE_PATH/.
    location = ${BASE_PATH} {
        return 301 ${BASE_PATH}/;
    }
}
