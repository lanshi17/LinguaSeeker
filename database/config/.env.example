# ── PostgreSQL ─────────────────────────────────────────────────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=acmg_ps3
POSTGRES_USER=[redacted-user]
POSTGRES_PASSWORD=[redacted-postgres-password]
POSTGRES_SCHEMA=acmg_app
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=30

# ── Alembic (run from repo root) ──────────────────────────────────────
# uv run alembic -c database/alembic.ini upgrade head
# uv run alembic -c database/alembic.ini revision --autogenerate -m "description"

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20

# Neo4j 配置
NEO4J_AUTH=neo4j/@bjdnEZfx543aGQZ

# Qdrant 配置
