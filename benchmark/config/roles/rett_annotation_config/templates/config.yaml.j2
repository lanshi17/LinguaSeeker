# Managed by Ansible — do not edit by hand.
# Source: benchmark/config/{inventories/local/group_vars,roles/rett_annotation_config/templates,vault/secrets.yml}
# Re-render with: ansible-playbook playbooks/deploy-config.yml
llm:
  base_url: "{{ rett_annotation_llm.base_url }}"
  model: "{{ rett_annotation_llm.model }}"
  max_tokens: {{ rett_annotation_llm.max_tokens }}
  temperature: {{ rett_annotation_llm.temperature }}
  timeout: {{ rett_annotation_llm.timeout }}
{% if rett_annotation_llm_fallback.enabled | default(false) %}
# Optional fallback provider
llm_fallback:
  base_url: "{{ rett_annotation_llm_fallback.base_url }}"
  model: "{{ rett_annotation_llm_fallback.model }}"
  max_tokens: {{ rett_annotation_llm_fallback.max_tokens }}
  temperature: {{ rett_annotation_llm_fallback.temperature }}
  timeout: {{ rett_annotation_llm_fallback.timeout }}
{% endif %}
pdf_parser:
  backend: "{{ rett_annotation_pdf_parser.backend }}"
  mineru_base_url: "{{ rett_annotation_pdf_parser.mineru_base_url }}"
  mineru_model_version: "{{ rett_annotation_pdf_parser.mineru_model_version }}"
  mineru_enable_formula: {{ rett_annotation_pdf_parser.mineru_enable_formula | lower }}
  mineru_enable_table: {{ rett_annotation_pdf_parser.mineru_enable_table | lower }}
  mineru_language: "{{ rett_annotation_pdf_parser.mineru_language }}"
  poll_interval: {{ rett_annotation_pdf_parser.poll_interval }}
  max_poll_attempts: {{ rett_annotation_pdf_parser.max_poll_attempts }}
  batch_size: {{ rett_annotation_pdf_parser.batch_size }}
annotation:
  max_concurrency: {{ rett_annotation_annotation.max_concurrency }}
  chunk_size: {{ rett_annotation_annotation.chunk_size }}
paths:
  pdf_source_dir: "{{ rett_annotation_paths.pdf_source_dir }}"
  draft_dir: "{{ rett_annotation_paths.draft_dir }}"
  approved_dir: "{{ rett_annotation_paths.approved_dir }}"
  rejected_dir: "{{ rett_annotation_paths.rejected_dir }}"
  ground_truth_dir: "{{ rett_annotation_paths.ground_truth_dir }}"
