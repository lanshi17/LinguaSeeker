{# ============================================================================
   Rendered Configuration Template
   ============================================================================
   Merges layered variables (defaults -> environment -> vault) into the nested
   YAML shape used by backend/config. This is a debugging/export template only;
   runtime loading reads backend/config directly.

   Render via: scripts/render_config.py
   Output:     stdout or an explicit debugging path
   ============================================================================ #}
# Auto-generated configuration — DO NOT EDIT MANUALLY
# Generated from: defaults/main.yaml + environments/{{ environment }}.yaml + vault/{{ environment }}.yaml
# Regenerate with: uv run python scripts/render_config.py --env {{ environment }}

# ── App ──────────────────────────────────────────────────────────────────
cors_origins: "{{ cors_origins }}"
environment: {{ environment }}
debug: {{ debug | lower }}

# ── Fast LLM (OpenAI-compatible) ────────────────────────────────────────
fast_llm:
  api_key: {{ fast_llm.api_key | default('') }}
  base_url: {{ fast_llm.base_url | default('') }}
  model: {{ fast_llm.model }}
  timeout: {{ fast_llm.timeout }}

# ── Reasoning LLM ───────────────────────────────────────────────────────
reasoning_llm:
  api_key: {{ reasoning_llm.api_key | default('') }}
  model: {{ reasoning_llm.model }}
  reasoning_effort: {{ reasoning_llm.reasoning_effort }}
  base_url: {{ reasoning_llm.base_url | default('') }}
  timeout: {{ reasoning_llm.timeout }}

# ── Chat Interaction LLM (lightweight conversational) ────────────────────
chat_llm:
  api_key: {{ chat_llm.api_key | default('') }}
  base_url: {{ chat_llm.base_url | default('') }}
  model: {{ chat_llm.model }}
  timeout: {{ chat_llm.timeout }}


# ── Embedding (external inference service) ─────────────────────────────
embedding:
  base_url: {{ embedding.base_url | default('') }}
  model: {{ embedding.model }}
  dimension: {{ embedding.dimension }}
  batch_size: {{ embedding.batch_size }}

# ── Rerank (external inference service) ────────────────────────────────
rerank:
  base_url: {{ rerank.base_url | default('') }}
  model: {{ rerank.model }}
  top_k: {{ rerank.top_k }}
  score_threshold: {{ rerank.score_threshold }}

# ── MinerU document parsing ─────────────────────────────────────────────
mineru:
  max_file_size_mb: {{ mineru.max_file_size_mb }}
  api_token: {{ mineru.api_token | default('') }}
  remote_poll_interval: {{ mineru.remote_poll_interval }}
  remote_max_poll_attempts: {{ mineru.remote_max_poll_attempts }}
  local_parse_url: {{ mineru.local_parse_url }}
  local_model_id: {{ mineru.local_model_id }}
  local_timeout: {{ mineru.local_timeout }}
  local_dpi: {{ mineru.local_dpi }}

# ── Inference Service Auth ────────────────────────────────────────────
inference_api_key: "{{ inference_api_key | default('') }}"

# ── Redis ───────────────────────────────────────────────────────────────
redis:
  host: {{ redis.host }}
  port: {{ redis.port }}
  password: "{{ redis.password | default('') }}"
  db: {{ redis.db }}
  max_connections: {{ redis.max_connections }}

# ── PostgreSQL ──────────────────────────────────────────────────────────
postgres:
  host: {{ postgres.host | default('127.0.0.1') }}
  port: {{ postgres.port }}
  db: {{ postgres.db | default('lingua_seeker') }}
  schema: {{ postgres.schema | default('lingua_seeker') }}
  user: {{ postgres.user | default('') }}
  password: {{ postgres.password | default('') }}
  pool_size: {{ postgres.pool_size }}
  max_overflow: {{ postgres.max_overflow }}

# ── Web Search ──────────────────────────────────────────────────────────
web_search:
  firecrawl_api_key: {{ web_search.firecrawl_api_key | default('') }}
  base_url: {{ web_search.base_url }}
  timeout: {{ web_search.timeout }}
  max_results: {{ web_search.max_results }}
  tavily_api_key: {{ web_search.tavily_api_key | default('') }}
  tavily_search_depth: {{ web_search.tavily_search_depth | default('basic') }}
  serpapi_api_key: {{ web_search.serpapi_api_key | default('') }}
  serpapi_engine: {{ web_search.serpapi_engine | default('google') }}

# ── Literature Acquisition Providers ────────────────────────────────────
unpaywall:
  email: {{ unpaywall.email | default('') }}

pubmed:
  api_key: {{ pubmed.api_key | default('') }}

base:
  api_key: {{ base.api_key | default('') }}

core:
  api_key: {{ core.api_key | default('') }}

# ── Network / Proxy ────────────────────────────────────────────────────
network:
  proxy: {{ network.proxy | default('') }}
  no_proxy: "{{ network.no_proxy | default('') }}"

# ── Inference Service GPU settings ──────────────────────────────────────
doc_parse_model_id: "{{ doc_parse_model_id | default('') }}"
embedding_gpu_memory_utilization: {{ embedding_gpu_memory_utilization | default(0.35) }}
embedding_max_model_len: {{ embedding_max_model_len | default(4096) }}
rerank_gpu_memory_utilization: {{ rerank_gpu_memory_utilization | default(0.2) }}
doc_parse_gpu_memory_utilization: {{ doc_parse_gpu_memory_utilization | default(0.5) }}
