# ═══════════════════════════════════════════════════════════
# Layer 1: Safe defaults — committed to git.
# Override via .env.development, .env.local, or OS env vars.
# ═══════════════════════════════════════════════════════════

# ─── App ───
VITE_APP_NAME=ACMG Lingua
VITE_APP_VERSION=1.1.1
VITE_API_KEY=
# ─── API ───
# SPA mount path (production subpath, e.g. /linguaseeker). Empty = root.
# API + health URLs derive from this via import.meta.env.BASE_URL, so the app
# is portable across mount points — do NOT hardcode /api/v1 or /health here.
VITE_BASE_PATH=
VITE_API_TIMEOUT=30000
VITE_HEALTH_POLL_INTERVAL=30000


# ─── Feature Flags ───
VITE_ENABLE_CHAT=true
VITE_ENABLE_GRAPH=true
