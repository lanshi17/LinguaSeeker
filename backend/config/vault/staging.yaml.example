# ============================================================================
# Staging Secrets Template
# ============================================================================
# Copy to staging.yaml and fill in your actual credentials.
# This file is git-ignored — NEVER commit real secrets.
# ============================================================================

# -- Application Auth ---------------------------------------------------------
session_signing_key: "generate-a-random-64-char-hex-string"

# -- LLM API Keys -------------------------------------------------------------
fast_llm:
  api_key: "your-staging-fast-llm-api-key"

reasoning_llm:
  api_key: "your-staging-reasoning-api-key"

chat_llm:
  api_key: "your-staging-chat-llm-api-key"

translation_llm:
  api_key: "your-staging-translation-llm-api-key"

# -- MinerU API Tokens -------------------------------------------------------
mineru:
  api_token: "your-staging-mineru-api-token"
  remote_api_token: "your-staging-mineru-remote-api-token"

# -- Embedding / Rerank Remote API Keys --------------------------------------
embedding:
  remote_api_key: "your-staging-embedding-remote-api-key"

rerank:
  remote_api_key: "your-staging-rerank-remote-api-key"

# -- Database Credentials -----------------------------------------------------
postgres:
  user: "lingua_seeker"
  password: "your-staging-postgres-password"

redis:
  password: "your-staging-redis-password"

# -- Inference Service Auth --------------------------------------------------
inference_api_key: "your-inference-service-api-key"

# -- Web Search ---------------------------------------------------------------
web_search:
  firecrawl_api_key: "your-firecrawl-api-key"
  tavily_api_key: "your-tavily-api-key"
  tavily_search_depth: "basic"
  serpapi_api_key: "your-serpapi-api-key"
  serpapi_engine: "google"

# -- Literature Acquisition API Keys ------------------------------------------
pubmed:
  api_key: "your-staging-pubmed-api-key"

base:
  api_key: "your-staging-base-api-key"

core:
  api_key: "your-staging-core-api-key"
