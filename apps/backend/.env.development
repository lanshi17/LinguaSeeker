# ==================== 应用配置 ====================
APP_NAME="ACMG-PS3 Intelligence System"
APP_VERSION="2.1.0"
ENVIRONMENT="production"
DEBUG="false"
API_HOST="0.0.0.0"
API_PORT="8000"

# ==================== LLM配置 ====================
# 双LLM架构配置 (v2.1.0+)
# 统一使用Anthropic兼容格式
# 主力LLM: DeepSeek-V3.2 (Anthropic兼容) - 用于快速任务
# 仲裁LLM: Claude 3.5 Sonnet/Opus (Anthropic原生) - 用于关键决策

# DeepSeek-V3.2 (主力LLM - Anthropic兼容格式)
DEEPSEEK_API_KEY="sk-qqkhvtehvscrwenhzixflzzmmdgzmzaufwurejxgnfbrxcjo"
DEEPSEEK_BASE_URL="https://api.siliconflow.cn/v1/messages"
DEEPSEEK_MODEL="deepseek-ai/DeepSeek-V3.2"

# Claude (仲裁LLM - Anthropic原生格式)
CLAUDE_API_KEY="sk-RB9ZAehItduW4zhIZGNZcZ5vemaqhIrYPi0JOQYm1ebt7nCO"
CLAUDE_MODEL="claude-haiku-4-5-20251001"
ANTHROPIC_BASE_URL="https://yunwu.ai/v1"

# LLM通用配置
LLM_TEMPERATURE="0"
LLM_MAX_TOKENS="2000"
LLM_TIMEOUT="60"
LLM_MAX_RETRIES="3"

# 调用模式（保留用于本地部署）
LLM_MODE="api"

# ==================== Embedding配置 ====================
EMBEDDING_PROVIDER="qwen"
EMBEDDING_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
EMBEDDING_MODEL="text-embedding-v4"
EMBEDDING_DIMENSION="1536"
EMBEDDING_BATCH_SIZE="10"

