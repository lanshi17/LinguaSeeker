# Auto-generated by Ansible — DO NOT EDIT MANUALLY
[Unit]
Description=Lingua Seeker Backend (FastAPI)
After=network.target docker.service
Requires=docker.service

[Service]
Type=exec
User=deploy
Group=deploy
WorkingDirectory={{ backend_root }}
Environment=ENVIRONMENT=production
Environment=PATH=/home/deploy/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=INFERENCE_API_KEY={{ inference_api_key }}
ExecStart=/home/deploy/.local/bin/uv run uvicorn app.main:app \
    --host 127.0.0.1 \
    --port {{ backend_port }} \
    --workers {{ backend_workers }} \
    --log-level {{ backend_log_level }} \
    --access-log \
    --proxy-headers \
    --forwarded-allow-ips='127.0.0.1'
Restart=always
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=60

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{ backend_root }}/logs
ReadWritePaths={{ backend_root }}/data
ReadWritePaths=/tmp
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
