# ============================================================================
# Production Secrets Template
# ============================================================================
# Copy to production.yaml and fill in your actual credentials.
# This file is git-ignored — NEVER commit real secrets.
# ============================================================================

# -- Application Auth ---------------------------------------------------------
# Session signing key (HMAC-SHA256 secret for ce_session cookies).
# MUST differ from api_key to prevent session forgery if api_key is leaked.
# Falls back to api_key if empty (not recommended for production).
session_signing_key: "generate-a-random-64-char-hex-string"

# -- LLM API Keys -------------------------------------------------------------
fast_llm:
  api_key: "your-production-fast-llm-api-key"

reasoning_llm:
  api_key: "your-production-reasoning-api-key"

chat_llm:
  api_key: "your-production-chat-llm-api-key"

translation_llm:
  api_key: "your-production-translation-llm-api-key"
  # Optional when translation_llm.remote_base_url is set.
  remote_api_keys:
    - "your-production-translation-remote-api-key-1"
    - "your-production-translation-remote-api-key-2"

# -- MinerU API Tokens -------------------------------------------------------
mineru:
  api_token: "your-production-mineru-api-token"
  remote_api_token: "your-production-mineru-remote-api-token"

# -- Embedding / Rerank Remote API Keys --------------------------------------
embedding:
  remote_api_keys:
    - "your-production-embedding-remote-api-key-1"
    - "your-production-embedding-remote-api-key-2"


rerank:
  remote_api_keys:
    - "your-production-rerank-remote-api-key-1"
    - "your-production-rerank-remote-api-key-2"


# -- Database Credentials -----------------------------------------------------
postgres:
  user: "lingua_seeker"
  password: "your-production-postgres-password"

redis:
  password: "your-production-redis-password"

# -- Inference Service Auth --------------------------------------------------
inference_api_key: "your-inference-service-api-key"

# -- Web Search ---------------------------------------------------------------
web_search:
  firecrawl_api_key: "your-firecrawl-api-key"
  tavily_api_key: "your-tavily-api-key"
  tavily_search_depth: "basic"
  serpapi_api_key: "your-serpapi-api-key"
  serpapi_engine: "google"

# -- Literature Acquisition API Keys ------------------------------------------
pubmed:
  api_key: "your-production-pubmed-api-key"

base:
  api_key: "your-production-base-api-key"

core:
  api_key: "your-production-core-api-key"
