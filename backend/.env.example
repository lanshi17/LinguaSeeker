# Server configuration
HOST=0.0.0.0
PORT=8080

# PostgreSQL database connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/evidence_platform

# Redis cache connection
REDIS_URL=redis://localhost:6379

# LLM API configuration (e.g., Ollama)
LLM_API_URL=http://localhost:11434/api/generate
LLM_API_KEY=

# ClinVar API key (optional, for higher rate limits)
# Get one from: https://www.ncbi.nlm.nih.gov/account/settings/
CLINVAR_API_KEY=

# Logging level (debug, info, warn, error)
RUST_LOG=evidence_platform=info,tower_http=info
