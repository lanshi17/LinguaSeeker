# Frontend environment variables
# Copy to .env.local for local development.
# Secrets (API_KEY) go in .env.<mode>.local (git-ignored).

# SPA mount path — production subpath (e.g. /linguaseeker); empty/root for dev.
# API + health URLs derive from the Vite base, so the app is portable.
VITE_BASE_PATH=
VITE_API_TIMEOUT=30000
VITE_DEBUG=false
VITE_HEALTH_POLL_INTERVAL=30000
VITE_API_KEY=
# Proxy target for Vite dev server (default: localhost:8000)
# BACKEND_URL=http://localhost:8000
