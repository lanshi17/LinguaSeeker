# Auto-generated by Ansible — DO NOT EDIT MANUALLY
# Lingua Seeker frontend host — genemed.tech
# ============================================================================
# Split-host topology: serves the built SPA dist under /linguaseeker and
# proxies API/health to the backend host (furong.genemed.tech / GPU15).
#
# X-API-Key is injected HERE (the browser never sees it; the backend host is
# a pure passthrough). The key comes from the same vault as the backend.
#
# The SPA is built with VITE_BASE_PATH=/linguaseeker so index.html references
# /linguaseeker/assets/... and all API/health URLs derive from the Vite base.
#
# Required vars: frontend_domain_name, backend_domain_name, api_key,
#                frontend_dist_root (absolute path to the built dist directory)
# ============================================================================
#
# HTTP → HTTPS redirect + ACME
server {
    listen 80;
    server_name {{ frontend_domain_name }};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name {{ frontend_domain_name }};

    ssl_certificate     /etc/letsencrypt/live/{{ frontend_domain_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ frontend_domain_name }}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # ── API → backend host (inject X-API-Key; browser never sees it) ───────
    # /linguaseeker/api/v1/...  →  https://<backend>/api/v1/...
    location /linguaseeker/api/ {
        proxy_pass https://{{ backend_domain_name }}/api/;
        proxy_ssl_server_name on;
        proxy_set_header Host {{ backend_domain_name }};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-API-Key {{ api_key }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;            # SSE / chunked friendly
    }

    # ── Health → backend host (public liveness, no key needed) ────────────
    location /linguaseeker/health {
        proxy_pass https://{{ backend_domain_name }}/health;
        proxy_ssl_server_name on;
        proxy_set_header Host {{ backend_domain_name }};
        access_log off;
    }

    # ── SPA static assets (Vite fingerprinted, long cache) ────────────────
    location /linguaseeker/assets/ {
        alias {{ frontend_dist_root }}/assets/;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # ── SPA fallback (index.html must not be cached) ──────────────────────
    location /linguaseeker/ {
        alias {{ frontend_dist_root }}/;
        index index.html;
        try_files $uri $uri/ /linguaseeker/index.html;
    }

    location = /linguaseeker {
        return 301 /linguaseeker/;
    }
}
