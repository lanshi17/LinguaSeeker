# ==================== 应用配置 ====================
APP_NAME="ACMG-Lingua"
APP_VERSION="3.0.0"
API_PREFIX="/api/v1"
CORS_ORIGINS="*"
ENVIRONMENT="development"
DEBUG="false"
API_HOST="localhost"
API_PORT="8000"

# ==================== 智能体配置 ====================

#通用LLM (OpenAI兼容格式)
LLM_API_KEY="your-llm-api-key"
LLM_BASE_URL="https://api.deepseek.com"
LLM_MODEL="deepseek-v4-flash"


#多语种翻译LLM (OpenAI兼容格式)
MT_API_KEY="your-mt-api-key"
MT_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
MT_MODEL="qwen-mt-flash"



#图片提取LLM (OpenAI兼容格式) 默认关闭
VLM_API_KEY="your-vlm-api-key"
VLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
VLM_MODEL="qwen3-vl-flash"
VLM_ENABLE="false"


#专家裁决智能体 (OpenAI兼容格式-使用具有更强推理能力的模型)
ARBITRATION_API_KEY="your-arbitration-api-key"
ARBITRATION_MODEL="deepseek-v4-pro"
ARBITRATION_REASONING_EFFORT="xhigh"
ARBITRATION_BASE_URL="https://api.deepseek.com"

# LLM通用配置
LLM_TEMPERATURE="0"
LLM_MAX_TOKENS="2000"
LLM_TIMEOUT="60"
LLM_MAX_RETRIES="3"


# ==================== Embedding配置 ====================
#EMBEDDING_API_KEY="your-embedding-api-key" #本地部署不用填
EMBEDDING_BASE_URL="http://localhost:8001/v1"
EMBEDDING_MODEL="Qwen/Qwen3-Embedding-0.6B"
EMBEDDING_DIMENSION="1024"
EMBEDDING_BATCH_SIZE="10"

#===================== Rerank配置 ====================
#RERANK_API_KEY="your-rerank-api-key" #本地部署不用填
RERANK_BASE_URL="http://localhost:8001/v1"
RERANK_MODEL="bge-reranker-v2-m3"
RERANK_TOP_K="10"
RERANK_SCORE_THRESHOLD="0.7"

# ==================== MinerU 配置 ====================
MINERU_API_URL="https://mineru.net/api/v4"
MINERU_API_TOKEN="your-mineru-api-token"
MINERU_API_TOKEN_BACKUP="your-mineru-backup-api-token"
MINERU_VERSION="vlm"
MINERU_DOWNLOAD_DIR="/tmp/mineru_downloads"
MINERU_TIMEOUT="300"
MINERU_MAX_FILE_SIZE_MB="100"
# 兜底本地模型路径（当API调用失败时使用）
MINERU_MODEL_PATH=$HOME/.cache/huggingface/hub/models--opendatalab--MinerU2.5-Pro-2604-1.2B

# ==================== Parse Document 配置 ====================
# Remote MinerU API 配置
MINERU_REMOTE_API_TOKEN="your-mineru-remote-api-token"
MINERU_REMOTE_POLL_INTERVAL="2.0"
MINERU_REMOTE_MAX_POLL_ATTEMPTS="150"

# Local MinerU VLM 配置 (model-server)
MINERU_LOCAL_MODEL_SERVER_URL="http://localhost:8001"
MINERU_LOCAL_MODEL_ID="opendatalab/MinerU2.5-Pro-2604-1.2B"
MINERU_LOCAL_TIMEOUT="120.0"
MINERU_LOCAL_DPI="200"

# ==================== Redis配置 (缓存层) ====================
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD="your-redis-password"
REDIS_DB="0"
REDIS_MAX_CONNECTIONS="20"

# ==================== PostgreSQL配置 ====================
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT="5432"
POSTGRES_DB="acmg_ps3"
POSTGRES_SCHEMA="acmg_app"
POSTGRES_USER="acmg_user"
POSTGRES_PASSWORD="your-postgres-password"
POSTGRES_POOL_SIZE="20"
POSTGRES_MAX_OVERFLOW="30"
PGVECTOR_ENABLED="true"

# ==================== Neo4j配置====================
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your-neo4j-password"
NEO4J_DATABASE="neo4j"
NEO4J_MAX_CONNECTION_LIFETIME="3600"
NEO4J_MAX_CONNECTION_POOL_SIZE="50"


# ==================== MinIO配置 (默认使用本地HTTPS) ====================
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="your-minio-access-key"
MINIO_SECRET_KEY="your-minio-secret-key"
MINIO_API="s3v4"
MINIO_PATH="auto"
MINIO_BUCKET_NAME="acmg-bucket"
# 本地MinIO默认使用HTTPS，如需HTTP可显式将其改为"false"
MINIO_SECURE="false"
MINIO_ROOT_USER="your-minio-root-user"
MINIO_ROOT_PASSWORD="your-minio-root-password"

# ==================== 任务配置 ====================
MAX_REASONING_ITERATIONS="3"
TASK_TIMEOUT_SECONDS="3600"

# ==================== 文献获取配置 ====================
PUBMED_API_KEY="your-pubmed-api-key"
PUBMED_BASE_URL="https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi"
UNPAYWALL_EMAIL="your-email@example.com"
JSTAGE_PROXY="http://127.0.0.1:7890"

#=====================SMTP 邮箱配置==================
SMTP_HOST="smtp.exmail.qq.com"
SMTP_PORT="465"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM_EMAIL="your-email@example.com"

# ==================== Evidence Extraction 配置 ====================
EVIDENCE_EXTRACTION_API_KEY="your-evidence-extraction-api-key"
EVIDENCE_EXTRACTION_BASE_URL="https://api.deepseek.com"
EVIDENCE_EXTRACTION_FAST_MODEL="deepseek-v4-flash"
EVIDENCE_EXTRACTION_STANDARD_MODEL="deepseek-v4-standard"
EVIDENCE_EXTRACTION_STRONG_MODEL="deepseek-v4-pro"
EVIDENCE_EXTRACTION_TEMPERATURE="0.0"
EVIDENCE_EXTRACTION_TIMEOUT="60"
EVIDENCE_EXTRACTION_MAX_RETRIES="3"
