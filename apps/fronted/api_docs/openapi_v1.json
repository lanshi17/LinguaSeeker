  "components": {
    "schemas": {
      "Body_upload_pdf_form_api_v1_pdf_upload_form_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File",
            "description": "PDF file to upload"
          },
          "priority": {
            "type": "integer",
            "maximum": 10,
            "minimum": 0,
            "title": "Priority",
            "description": "Processing priority (0-10)",
            "default": 0
          }
        },
        "type": "object",
        "required": ["file"],
        "title": "Body_upload_pdf_form_api_v1_pdf_upload_form_post"
      },
      "EvidenceItemSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique identifier for the evidence item"
          },
          "acmg_code": {
            "type": "string",
            "title": "Acmg Code",
            "description": "ACMG evidence code (e.g., PS1, PM2)"
          },
          "confidence_score": {
            "type": "number",
            "maximum": 1,
            "minimum": 0,
            "title": "Confidence Score",
            "description": "Confidence score between 0.0 and 1.0"
          },
          "review_required": {
            "type": "boolean",
            "title": "Review Required",
            "description": "Whether human review is required (confidence \u003C 0.85)"
          },
          "source_page": {
            "type": "integer",
            "title": "Source Page",
            "description": "Page number in the original document"
          }
        },
        "type": "object",
        "required": [
          "id",
          "acmg_code",
          "confidence_score",
          "review_required",
          "source_page"
        ],
        "title": "EvidenceItemSummary",
        "description": "Summary of an evidence item for task status response."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PDFUploadRequest": {
        "properties": {
          "file_content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Content",
            "description": "Base64 encoded PDF file content",
            "example": "JVBERi0xLjQKJcfs..."
          },
          "filename": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filename",
            "description": "Original filename of the uploaded PDF",
            "example": "research_paper.pdf"
          },
          "pmid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pmid",
            "description": "PubMed ID for automatic document fetching",
            "example": "12345678"
          },
          "doi": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doi",
            "description": "DOI for automatic document fetching",
            "example": "10.1038/s41586-023-06221-2"
          },
          "source": {
            "$ref": "#/components/schemas/UploadSource",
            "description": "Source of the document upload",
            "default": "file"
          },
          "priority": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10,
                "minimum": 0
              },
              {
                "type": "null"
              }
            ],
            "title": "Priority",
            "description": "Processing priority (0 = normal, higher = more urgent)",
            "default": 0
          }
        },
        "type": "object",
        "title": "PDFUploadRequest",
        "description": "Request DTO for uploading PDF documents or fetching by PMID/DOI.\n\nEither file_content OR (pmid OR doi) must be provided.",
        "example": {
          "file_content": "JVBERi0xLjQKJcfs...",
          "filename": "acmg_evidence_study.pdf",
          "priority": 0,
          "source": "file"
        }
      },
      "TaskStatus": {
        "type": "string",
        "enum": ["pending", "processing", "completed", "failed", "cancelled"],
        "title": "TaskStatus",
        "description": "文档处理任务状态枚举"
      },
      "TaskStatusResponse": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id",
            "description": "Unique identifier for the parsing task"
          },
          "document_id": {
            "type": "string",
            "title": "Document Id",
            "description": "Unique identifier for the associated document"
          },
          "status": {
            "$ref": "#/components/schemas/src__presentation__dtos__response__task_status_response__TaskStatus",
            "description": "Current status of the parsing task"
          },
          "progress_percentage": {
            "type": "integer",
            "maximum": 100,
            "minimum": 0,
            "title": "Progress Percentage",
            "description": "Progress percentage (0-100)",
            "default": 0
          },
          "current_stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Stage",
            "description": "Current processing stage"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Timestamp when the task was created"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At",
            "description": "Timestamp when the task was last updated"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At",
            "description": "Timestamp when the task was completed"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message",
            "description": "Error message if task failed"
          },
          "evidence_items": {
            "items": {
              "$ref": "#/components/schemas/EvidenceItemSummary"
            },
            "type": "array",
            "title": "Evidence Items",
            "description": "List of extracted evidence items with summary information"
          },
          "processing_time_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Processing Time Seconds",
            "description": "Total processing time in seconds"
          },
          "file_size_bytes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size Bytes",
            "description": "Original file size in bytes"
          }
        },
        "type": "object",
        "required": [
          "task_id",
          "document_id",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "TaskStatusResponse",
        "description": "Response DTO for querying parsing task status.",
        "example": {
          "completed_at": "2026-01-31T10:05:30Z",
          "created_at": "2026-01-31T10:00:00Z",
          "current_stage": "Evidence Extraction",
          "document_id": "doc_67890",
          "evidence_items": [
            {
              "acmg_code": "PS1",
              "confidence_score": 0.92,
              "id": "evid_1",
              "review_required": false,
              "source_page": 5
            },
            {
              "acmg_code": "PM2",
              "confidence_score": 0.78,
              "id": "evid_2",
              "review_required": true,
              "source_page": 12
            }
          ],
          "file_size_bytes": 2048000,
          "processing_time_seconds": 330.5,
          "progress_percentage": 100,
          "status": "completed",
          "task_id": "task_12345",
          "updated_at": "2026-01-31T10:05:30Z"
        }
      },
      "UploadSource": {
        "type": "string",
        "enum": ["file", "pmid", "doi"],
        "title": "UploadSource"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      },
      "src__domain__models__document_task__TaskStatusResponse": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id",
            "description": "任务ID"
          },
          "document_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Id",
            "description": "文档ID"
          },
          "file_name": {
            "type": "string",
            "title": "File Name",
            "description": "文件名"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus",
            "description": "任务状态"
          },
          "progress": {
            "type": "integer",
            "title": "Progress",
            "description": "处理进度(0-100)"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message",
            "description": "错误信息"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result",
            "description": "处理结果"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "创建时间"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At",
            "description": "更新时间"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At",
            "description": "完成时间"
          }
        },
        "type": "object",
        "required": [
          "task_id",
          "file_name",
          "status",
          "progress",
          "created_at",
          "updated_at"
        ],
        "title": "TaskStatusResponse",
        "description": "任务状态查询响应"
      },
      "src__presentation__dtos__response__task_status_response__TaskStatus": {
        "type": "string",
        "enum": ["pending", "processing", "completed", "failed", "cancelled"],
        "title": "TaskStatus"
      }
    }
  },
  "tags": [
    {
      "name": "PDF Parsing",
      "description": "Upload and parse PDF documents for ACMG evidence extraction"
    },
    {
      "name": "Task Management",
      "description": "Monitor and manage parsing task status and lifecycle"
    }
  ]
}
