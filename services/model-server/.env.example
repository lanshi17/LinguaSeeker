# ============================================================================
# Model Server — Standalone Configuration
# ============================================================================
# This service is fully decoupled from the backend project.
# All configuration comes from environment variables (or this .env file).
#
# Copy to .env and adjust as needed:
#   cp .env.example .env
#
# For Docker deployment, these values are set in docker-compose.model-server.yml
# ============================================================================

# ── Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=info

# ── Auth ───────────────────────────────────────────────────────────────────
# API key for Bearer/X-API-Key auth. Empty = auth disabled (open access).
# When set, clients must send: Authorization: Bearer <key>  or  X-API-Key: <key>
API_KEY=

# ── HuggingFace Cache ──────────────────────────────────────────────────────
HF_HOME=~/.cache/huggingface/hub

# ── Embedding Model ────────────────────────────────────────────────────────
EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024
EMBEDDING_MAX_MODEL_LEN=8192
EMBEDDING_GPU_MEMORY_UTILIZATION=0.9

# ── Rerank Model ───────────────────────────────────────────────────────────
RERANK_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANK_MAX_MODEL_LEN=8192
RERANK_GPU_MEMORY_UTILIZATION=0.9

# ── Document Parsing (MinerU — doc-parse container only) ───────────────────
# Doc-parse uses MinerU's native doc_analyze API with a VLM backend.
# In Docker, these are set in docker-compose.model-server.yml.
DOC_PARSE_MODEL_ID=
DOC_PARSE_MODEL_PATH=
DOC_PARSE_BACKEND=vlm
DOC_PARSE_IMAGE_ANALYSIS=false
DOC_PARSE_GPU_MEMORY_UTILIZATION=0.9

# ── vllm Shared ────────────────────────────────────────────────────────────
VLLM_GPU_MEMORY_UTILIZATION=0.9
