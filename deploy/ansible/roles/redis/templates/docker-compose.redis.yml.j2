services:
  redis:
    image: redis:8.0-alpine
    container_name: cross-evidence-redis
    restart: unless-stopped
    ports:
      - "{{ redis_port }}:6379"
    command:
      - "redis-server"
      - "--maxmemory"
      - "512mb"
      - "--maxmemory-policy"
      - "allkeys-lru"
      - "--appendonly"
      - "yes"
{% if vault_redis_password is defined and vault_redis_password | length > 0 %}
      - "--requirepass"
      - "{{ vault_redis_password }}"
{% endif %}
    volumes:
      - /opt/cross-evidence-data/redis:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    deploy:
      resources:
        limits:
          memory: 768M
