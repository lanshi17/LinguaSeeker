# Shared environment variables (Docker Compose reads from here)
# Copy to .env and fill in actual values

# PostgreSQL
POSTGRES_DB=acmg_lingua
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Redis
REDIS_URL=redis://localhost:6379/0

# Cross-lingual output
CROSS_LINGUAL_OUTPUT_DIR=data/cross_lingual_output
