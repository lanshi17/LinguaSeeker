  "paths": {
    "/api/v1/pdf/upload": {
      "post": {
        "tags": ["PDF Parsing"],
        "summary": "Upload PDF document for parsing (JSON with Base64)",
        "description": "Upload a PDF document for asynchronous parsing.\n\nCreates a new parsing task and returns the task ID immediately.\nThe actual parsing happens asynchronously in the background.",
        "operationId": "upload_pdf_api_v1_pdf_upload_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PDFUploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Upload Pdf Api V1 Pdf Upload Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pdf/upload/form": {
      "post": {
        "tags": ["PDF Parsing"],
        "summary": "Upload PDF document for parsing (multipart/form-data)",
        "description": "Upload a PDF document using multipart/form-data for parsing.\n\nThis endpoint accepts direct file uploads via form-data.\nCreates a new parsing task and returns the task ID immediately.\nThe actual parsing happens asynchronously in the background.",
        "operationId": "upload_pdf_form_api_v1_pdf_upload_form_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_pdf_form_api_v1_pdf_upload_form_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Upload Pdf Form Api V1 Pdf Upload Form Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pdf/fetch-by-pmid": {
      "post": {
        "tags": ["PDF Parsing"],
        "summary": "Fetch and parse document by PMID",
        "description": "Fetch document by PMID and create parsing task.",
        "operationId": "fetch_by_pmid_api_v1_pdf_fetch_by_pmid_post",
        "parameters": [
          {
            "name": "pmid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Pmid"
            }
          },
          {
            "name": "priority",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": 0,
              "title": "Priority"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Fetch By Pmid Api V1 Pdf Fetch By Pmid Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pdf/fetch-by-doi": {
      "post": {
        "tags": ["PDF Parsing"],
        "summary": "Fetch and parse document by DOI",
        "description": "Fetch document by DOI and create parsing task.",
        "operationId": "fetch_by_doi_api_v1_pdf_fetch_by_doi_post",
        "parameters": [
          {
            "name": "doi",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Doi"
            }
          },
          {
            "name": "priority",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": 0,
              "title": "Priority"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Fetch By Doi Api V1 Pdf Fetch By Doi Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tasks/{task_id}": {
