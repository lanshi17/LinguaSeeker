# Auto-generated by Ansible — DO NOT EDIT MANUALLY
[Unit]
Description=Lingua Seeker Frontend (Vite+React static via nginx)
After=network.target
Wants=network.target

[Service]
Type=exec
User=deploy
Group=deploy
WorkingDirectory={{ frontend_root }}
Environment=NODE_ENV={{ frontend_node_env }}
Environment=BUN_INSTALL=/home/deploy/.bun
# Secrets loaded from restricted-permission file (not visible in `systemctl show`)
EnvironmentFile=/etc/lingua-seeker/frontend.env
Environment=PATH=/home/deploy/.bun/bin:/usr/local/bin:/usr/bin:/bin
# Serve the Vite build output as a static site.
# In production, nginx serves dist/ directly and proxies /api/v1 to the backend.
# This preview server is a fallback for health checks and direct access.
ExecStart=/home/deploy/.bun/bin/bun run preview -- --port {{ frontend_port }} --host 127.0.0.1
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
