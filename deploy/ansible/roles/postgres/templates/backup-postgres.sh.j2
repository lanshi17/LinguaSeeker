#!/bin/bash
# Auto-generated by Ansible — DO NOT EDIT MANUALLY
# Cross Evidence PostgreSQL backup — runs via cron daily at 03:00

set -euo pipefail

BACKUP_DIR="/opt/cross-evidence-data/postgres-backups"
CONTAINER="cross-evidence-postgres"
DB="{{ postgres_db }}"
USER="{{ postgres_user }}"
RETENTION_DAYS=30
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_FILE="${BACKUP_DIR}/${DB}_${TIMESTAMP}.sql.gz"

# Dump and compress
docker exec "$CONTAINER" pg_dump -U "$USER" -d "$DB" --no-owner --no-privileges \
  | gzip > "$BACKUP_FILE"

# Prune old backups
find "$BACKUP_DIR" -name "${DB}_*.sql.gz" -mtime +${RETENTION_DAYS} -delete

echo "Backup completed: ${BACKUP_FILE} ($(du -h "$BACKUP_FILE" | cut -f1))"
