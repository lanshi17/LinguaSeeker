# Frontend environment variables
# Copy to .env.local for local development.
# Secrets (API_KEY) go in .env.<mode>.local (git-ignored).

# API endpoint (relative URL goes through Vite dev-server proxy)
VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT=30000
VITE_DEBUG=false
VITE_HEALTH_POLL_INTERVAL=30000

# Proxy target for Vite dev server (default: localhost:8000)
# BACKEND_URL=http://localhost:8000
