# ==================== 应用配置 ====================
APP_NAME="ACMG-PS3 Intelligence System"
APP_VERSION="2.0.0"
ENVIRONMENT="development"  # development | staging | production
DEBUG="true"
API_HOST="0.0.0.0"
API_PORT="8000"

## ==================== 智能体配置 ====================

#文献获取智能体 (OpenAI兼容格式)
RETRIEVAL_API_KEY=""
RETRIEVAL_BASE_URL=""
RETRIEVAL_MODEL=""

#文档解析智能体 (OpenAI兼容格式)
PARSING_API_KEY=""
PARSING_BASE_URL=""
PARSING_MODEL=""

#多语种翻译智能体 (OpenAI兼容格式)
MT_API_KEY=""
MT_BASE_URL=""
MT_MODEL=""

#多功能排版智能体 (OpenAI兼容格式)
FORMAT_API_KEY=""
FORMAT_BASE_URL=""
FORMAT_MODEL=""

#图片提取智能体 (OpenAI兼容格式)
VLM_API_KEY=""
VLM_BASE_URL=""
VLM_MODEL=""
VLM_ENABLE="false"


#证据提取智能体 (Anthropic兼容格式)
EVIDENCE_API_KEY=""
EVIDENCE_BASE_URL=""
EVIDENCE_MODEL=""

#ACMG分类智能体 (Anthropic兼容格式)
CLASSIFICATION_API_KEY=""
CLASSIFICATION_BASE_URL=""
CLASSIFICATION_MODEL=""

#专家裁决智能体 (Anthropic原生格式)
ARBITRATION_API_KEY=""
ARBITRATION_MODEL=""
ARBITRATION_BASE_URL=""

# LLM通用配置
LLM_TEMPERATURE="0.7"
LLM_MAX_TOKENS="2000"
LLM_TIMEOUT="60"
LLM_MAX_RETRIES="3"

# 调用模式（保留用于本地部署）
LLM_MODE="api"  # api（远程API）| local（本地部署，待实现）

# ==================== Embedding配置 ====================
EMBEDDING_PROVIDER="nomic"  # nomic | openai
EMBEDDING_MODEL="nomic-embed-text"
EMBEDDING_DIMENSION="1536"
EMBEDDING_BATCH_SIZE="32"

# ==================== MinerU (Magic-PDF) 配置 ====================
MINERU_MODE="api"  # api | local
MINERU_API_URL="http://localhost:8080"
MINERU_TIMEOUT="300"
MINERU_MAX_FILE_SIZE_MB="100"

# ==================== PostgreSQL配置 ====================
# 开发环境可用 localhost；生产环境请使用远程主机名/地址
# 示例：POSTGRES_HOST="db.postgres.example.com"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="acmg_ps3"
POSTGRES_SCHEMA="public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-postgres-password"
POSTGRES_POOL_SIZE="10"
POSTGRES_MAX_OVERFLOW="20"

# ==================== Neo4j配置 ====================
# 示例：NEO4J_URI="bolt://neo4j.example.com:7687"
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your-neo4j-password"
NEO4J_DATABASE="neo4j"
NEO4J_MAX_CONNECTION_LIFETIME="3600"
NEO4J_MAX_CONNECTION_POOL_SIZE="50"

# ==================== 向量数据库选择 ====================
# 默认使用 Qdrant，可切换 Milvus
VECTOR_DB="qdrant"  # qdrant | milvus

# ==================== Milvus配置（可选） ====================
# 示例：MILVUS_HOST="milvus.example.com"
MILVUS_HOST="localhost"
MILVUS_PORT="19530"
MILVUS_COLLECTION_NAME="paper_chunks"
MILVUS_DIMENSION="1536"
MILVUS_INDEX_TYPE="IVF_FLAT"
MILVUS_METRIC_TYPE="L2"

# ==================== Qdrant配置（默认） ====================
# 示例：QDRANT_HOST="qdrant.example.com"
QDRANT_HOST="localhost"
QDRANT_PORT="6333"
QDRANT_COLLECTION_NAME="paper_chunks"
QDRANT_DIMENSION="1536"

# ==================== MinIO配置 ====================
# 示例：MINIO_ENDPOINT="minio.example.com:9000"
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="test-minio-access-key"
MINIO_SECRET_KEY="test-minio-secret-key"
MINIO_BUCKET_NAME="processed-results"
MINIO_UPLOADS_BUCKET="literature-uploads"
MINIO_RESULTS_BUCKET="processed-results"
# 生产建议开启 TLS
MINIO_SECURE="false"

# ==================== 任务配置 ====================
MAX_REASONING_ITERATIONS="3"
TASK_TIMEOUT_SECONDS="3600"
