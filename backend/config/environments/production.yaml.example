# ============================================================================
# Production Environment Configuration
# ============================================================================
# Copy to production.yaml and customize for your production deployment.
# Secrets go in vault/production.yaml (git-ignored)
# ============================================================================

# ── Application ───────────────────────────────────────────────────────────
environment: "production"
debug: false
cors_origins: "https://your-domain.com"

# ── LLM Endpoints (Production) ──────────────────────────────────────────
fast_llm:
  base_url: "https://api.production-llm.com/v1"

reasoning_llm:
  base_url: "https://api.production-llm.com/v1"

# ── Model Server (Production) ────────────────────────────────────────────
embedding:
  base_url: "http://model-server:8001/v1"

rerank:
  base_url: "http://model-server:8001/v1"

# ── Database Connections (Production) ────────────────────────────────────
postgres:
  host: "postgres-server"
  db: "cross_evidence"
  schema: "acmg_app"

redis:
  host: "redis-server"

# ── Literature Acquisition ────────────────────────────────────────────────
# Unpaywall requires a contact email — set to your institutional address.
# API keys (pubmed/base/core) go in vault/production.yaml.
unpaywall:
  email: "[redacted-email]"

# ── Network / Proxy ──────────────────────────────────────────────────────
network:
  proxy: ""
  no_proxy: "cn,ncbi.nlm.nih.gov,nlm.nih.gov,unpaywall.org,localhost,127.0.0.1"
