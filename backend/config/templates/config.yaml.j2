# ── Web Search ──────────────────────────────────────────────────────────
WEB_SEARCH_API_KEY: {{ web_search.api_key }}
WEB_SEARCH_BASE_URL: {{ web_search.base_url }}
WEB_SEARCH_TIMEOUT: {{ web_search.timeout }}
WEB_SEARCH_MAX_RESULTS: {{ web_search.max_results }}

# ── Model Server GPU settings ──────────────────────────────────────────
vlm_model_id: "{{ model_server.vlm_model_id }}"
embedding_gpu_memory_utilization: {{ model_server.embedding_gpu_memory_utilization }}
