# ==================== 应用配置 ====================
APP_NAME="ACMG-PS3 Intelligence System"
APP_VERSION="2.0.0"
ENVIRONMENT="production"
DEBUG="false"
API_HOST="0.0.0.0"
API_PORT="8000"

# ==================== LLM配置 ====================
LLM_MODE="api"

# DeepSeek-V3.2 (主力LLM)
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
OPENAI_API_BASE="https://api.deepseek.com"
OPENAI_API_KEY="your-deepseek-api-key"

# Claude Opus 4.5 (仲裁LLM)
CLAUDE_API_KEY="your-claude-api-key"
ANTHROPIC_BASE_URL="https://api.anthropic.com"
CLAUDE_MODEL="claude-opus-4.5"

# LLM通用配置
LLM_TEMPERATURE="0.7"
LLM_MAX_TOKENS="2000"
LLM_TIMEOUT="60"

# ==================== Embedding配置 ====================
EMBEDDING_PROVIDER="nomic"
EMBEDDING_MODEL="nomic-embed-text"
EMBEDDING_DIMENSION="1536"
EMBEDDING_BATCH_SIZE="32"

# ==================== MinerU 配置 ====================
MINERU_MODE="api"
MINERU_API_URL="http://mineru.example.com:8080"
MINERU_TIMEOUT="300"
MINERU_MAX_FILE_SIZE_MB="100"

# ==================== PostgreSQL配置 (远程) ====================
POSTGRES_HOST="db.postgres.example.com"
POSTGRES_PORT="5432"
POSTGRES_DB="acmg_ps3"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-secure-postgres-password"
POSTGRES_POOL_SIZE="20"
POSTGRES_MAX_OVERFLOW="30"

# ==================== Neo4j配置 (远程) ====================
NEO4J_URI="bolt://neo4j.example.com:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your-secure-neo4j-password"
NEO4J_DATABASE="neo4j"
NEO4J_MAX_CONNECTION_LIFETIME="3600"
NEO4J_MAX_CONNECTION_POOL_SIZE="50"

# ==================== 向量数据库选择 ====================
VECTOR_DB="qdrant"

# ==================== Qdrant配置 (远程) ====================
QDRANT_HOST="qdrant.example.com"
QDRANT_PORT="6333"
QDRANT_COLLECTION_NAME="paper_chunks"
QDRANT_DIMENSION="1536"
QDRANT_PREFER_GRPC="true"

# ==================== Milvus配置 (可选，备用) ====================
MILVUS_HOST="milvus.example.com"
MILVUS_PORT="19530"
MILVUS_COLLECTION_NAME="paper_chunks"
MILVUS_DIMENSION="1536"
MILVUS_INDEX_TYPE="IVF_FLAT"
MILVUS_METRIC_TYPE="L2"

# ==================== MinIO配置 (远程存储，启用TLS) ====================
MINIO_ENDPOINT="minio.example.com:9000"
MINIO_ACCESS_KEY="your-minio-access-key"
MINIO_SECRET_KEY="your-minio-secret-key"
MINIO_BUCKET_NAME="acmg-documents"
MINIO_SECURE="true"

# ==================== 任务配置 ====================
MAX_REASONING_ITERATIONS="3"
TASK_TIMEOUT_SECONDS="3600"
