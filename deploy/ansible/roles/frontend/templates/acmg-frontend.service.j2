# Auto-generated by Ansible — DO NOT EDIT MANUALLY
[Unit]
Description=Cross Evidence Frontend (Next.js)
After=network.target
Wants=network.target

[Service]
Type=exec
User=deploy
Group=deploy
WorkingDirectory={{ frontend_root }}
Environment=NODE_ENV={{ frontend_node_env }}
Environment=PORT={{ frontend_port }}
Environment=API_KEY={{ api_key }}
Environment=NVM_DIR=/home/deploy/.nvm
Environment=PATH=/home/deploy/.nvm/versions/node/v18/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/deploy/.nvm/versions/node/v18/bin/node node_modules/.bin/next start -p {{ frontend_port }}
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
