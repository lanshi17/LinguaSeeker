# ============================================================================
# Production Vault — Secrets (DO NOT commit the real vault.yml)
# ============================================================================
# Copy to vault.yml and encrypt with:
#   ansible-vault encrypt inventories/production/group_vars/vault.yml
#
# Edit with:
#   ansible-vault edit inventories/production/group_vars/vault.yml
# ============================================================================


# ── Frontend↔Backend Trust Token ──────────────────────────────────────────
# Shared secret injected by nginx as X-API-Key. Backend validates it via
# require_api_key and binds to 127.0.0.1, so it is only reachable via nginx.
vault_api_key: "change-me-to-a-strong-random-secret"
# ── LLM API Keys ─────────────────────────────────────────────────────────
vault_fast_llm_api_key: "sk-xxxxxxxxxxxxxxxxxxxxxxxx"
vault_reasoning_llm_api_key: "sk-xxxxxxxxxxxxxxxxxxxxxxxx"

# ── MinerU ────────────────────────────────────────────────────────────────
vault_mineru_api_token: "xxxxxxxxxxxxxxxxxxxxxxxx"


# ── Literature Acquisition API Keys ──────────────────────────────────────
# Optional but recommended: raises provider rate limits and unlocks full-text.
#   PUBMED_API_KEY -> NCBI E-utilities (3→10 req/s); applies to pmc + pubmed_service
#   BASE_API_KEY   -> BASE (Bielefeld Academic Search Engine)
#   CORE_API_KEY   -> CORE (core.ac.uk)
vault_pubmed_api_key: "your-ncbi-api-key"
vault_base_api_key: ""
vault_core_api_key: ""

# ── PostgreSQL ────────────────────────────────────────────────────────────
vault_postgres_password: "change-me-to-a-strong-password"

# ── Redis ─────────────────────────────────────────────────────────────────
vault_redis_password: "change-me-to-a-strong-password"

# ── SSH / Deploy ──────────────────────────────────────────────────────────
vault_deploy_ssh_private_key: ""   # Optional: inline private key for CI/CD
