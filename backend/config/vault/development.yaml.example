# ============================================================================
# Development Secrets Template
# ============================================================================
# Copy to development.yaml and fill in your actual credentials.
# This file is git-ignored — NEVER commit real secrets.
# ============================================================================

# ── LLM API Keys ──────────────────────────────────────────────────────────
# Single key (backward compatible):
#   fast_llm:
#     api_key: "your-fast-llm-api-key"
#
# Key pool (high concurrency — round-robin rotation with failover):
#   fast_llm:
#     api_keys:
#       - "key-1"
#       - "key-2"
#       - "key-3"
fast_llm:
  api_key: "your-fast-llm-api-key"

reasoning_llm:
  api_key: "your-reasoning-api-key"

# ── MinerU API Tokens ────────────────────────────────────────────────────
# Flattens to MINERU_API_TOKEN, MINERU_API_TOKEN_BACKUP, MINERU_REMOTE_API_TOKEN
mineru:
  api_token: "your-mineru-api-token"
  remote_api_token: "your-mineru-remote-api-token"

# ── Embedding / Rerank Remote API Keys ──────────────────────────────────
# API keys for remote fallback providers (e.g. SiliconFlow).
# Only needed when embedding.remote_base_url / rerank.remote_base_url are set.
embedding:
  remote_api_key: "your-embedding-remote-api-key"

rerank:
  remote_api_key: "your-rerank-remote-api-key"

# ── Database Credentials ─────────────────────────────────────────────────
postgres:
  user: "your-postgres-user"
  password: "your-postgres-password"

redis:
  password: ""

# ── Literature Acquisition API Keys ──────────────────────────────────────
# Optional but recommended: raises provider rate limits and unlocks full-text.
#   PUBMED_API_KEY  -> NCBI E-utilities (3→10 req/s); applies to pmc + pubmed_service
#   BASE_API_KEY    -> BASE (Bielefeld Academic Search Engine)
#   CORE_API_KEY    -> CORE (core.ac.uk)
pubmed:
  api_key: "your-pubmed-api-key"

base:
  api_key: "your-base-api-key"

core:
  api_key: "your-core-api-key"
