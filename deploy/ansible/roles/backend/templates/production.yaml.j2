# Auto-generated by Ansible — DO NOT EDIT MANUALLY
# Lingua Seeker Production Environment Config
# Generated from: deploy/ansible/inventories/production/group_vars/all.yml

environment: "production"
debug: {{ acmg_debug | lower }}
cors_origins: "{{ acmg_cors_origins }}"
api_key: "{{ api_key }}"

# ── LLM Endpoints ────────────────────────────────────────────────────────
fast_llm:
  base_url: "{{ fast_llm_base_url }}"
  model: "{{ fast_llm_model }}"
  timeout: {{ fast_llm_timeout }}
  max_tokens: {{ fast_llm_max_tokens }}

reasoning_llm:
  base_url: "{{ reasoning_llm_base_url }}"
  model: "{{ reasoning_llm_model }}"
  reasoning_effort: "{{ reasoning_llm_reasoning_effort }}"
  timeout: {{ reasoning_llm_timeout }}
  max_tokens: {{ reasoning_llm_max_tokens }}

# ── Inference Services ────────────────────────────────────────────────────
embedding:
  base_url: "{{ embedding_base_url }}"
  model: "{{ embedding_model }}"
  dimension: {{ embedding_dimension }}
  batch_size: {{ embedding_batch_size }}
  api_style: "{{ embedding_api_style }}"

rerank:
  base_url: "{{ rerank_base_url }}"
  model: "{{ rerank_model }}"
  top_k: {{ rerank_top_k }}
  score_threshold: {{ rerank_score_threshold }}
  api_style: "{{ rerank_api_style }}"

# ── MinerU ───────────────────────────────────────────────────────────────
mineru:
  max_file_size_mb: {{ mineru_max_file_size_mb }}
  remote_poll_interval: {{ mineru_remote_poll_interval }}
  remote_max_poll_attempts: {{ mineru_remote_max_poll_attempts }}
  local_parse_url: "{{ mineru_local_parse_url }}"
  local_model_id: "{{ mineru_local_model_id }}"
  local_timeout: {{ mineru_local_timeout }}
  local_dpi: {{ mineru_local_dpi }}

# ── Database ─────────────────────────────────────────────────────────────
postgres:
  host: "{{ postgres_host }}"
  port: {{ postgres_port }}
  db: "{{ postgres_db }}"
  schema: "{{ postgres_schema }}"
  pool_size: {{ postgres_pool_size }}
  max_overflow: {{ postgres_max_overflow }}

redis:
  host: "{{ redis_host }}"
  port: {{ redis_port }}
  db: {{ redis_db }}
  max_connections: {{ redis_max_connections }}

pipeline:
  cache_enabled: {{ pipeline_cache_enabled | lower }}
  dedup_enabled: {{ pipeline_dedup_enabled | lower }}

# ── Literature Acquisition ───────────────────────────────────────────────
# Unpaywall requires a contact email (not secret).
# API keys (pubmed/base/core) are in vault-production.yaml.
unpaywall:
  email: "{{ unpaywall_email }}"

# ── Network ──────────────────────────────────────────────────────────────
network:
  proxy: "{{ network_proxy }}"
  no_proxy: "{{ network_no_proxy }}"

# ── Inference Service GPU ─────────────────────────────────────────────────
embedding_gpu_memory_utilization: {{ embedding_gpu_memory_utilization }}
embedding_max_model_len: {{ embedding_max_model_len }}
rerank_gpu_memory_utilization: {{ rerank_gpu_memory_utilization }}
doc_parse_gpu_memory_utilization: {{ doc_parse_gpu_memory_utilization }}
