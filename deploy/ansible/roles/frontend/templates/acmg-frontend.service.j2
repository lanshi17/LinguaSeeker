[Unit]
Description=Cross Evidence Frontend (Next.js via bun)
After=network.target
Wants=network.target

[Service]
Type=exec
User=deploy
Group=deploy
WorkingDirectory={{ frontend_root }}
Environment=NODE_ENV={{ frontend_node_env }}
Environment=PORT={{ frontend_port }}
Environment=BUN_INSTALL=/home/deploy/.bun
# Secrets loaded from restricted-permission file (not visible in `systemctl show`)
