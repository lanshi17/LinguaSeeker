# ============================================================================
# Lingua Seeker — Single-Server .env
# ============================================================================
# Copy to .env, fill in all secrets, then:
#   docker compose --env-file .env up -d
# ============================================================================

# ── Network ───────────────────────────────────────────────────────────────
BACKEND_BIND=0.0.0.0
BACKEND_PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────
# The origin the browser sees (scheme + host + port, no trailing slash)
CORS_ORIGINS=https://furong.genemed.tech

# ── Auth ──────────────────────────────────────────────────────────────────
# Shared secret for X-API-Key auth (nginx injects this; browser never sees it)
API_KEY=change-me-to-a-long-random-string
# HMAC-SHA256 secret for session cookies (must differ from API_KEY)
SESSION_SIGNING_KEY=change-me-to-a-different-random-hex

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_DB=lingua_seeker
POSTGRES_USER=lingua_seeker
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_SCHEMA=lingua_seeker

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── Model Server Auth ─────────────────────────────────────────────────────
# Shared secret between backend and model-server containers
MODEL_SERVER_API_KEY=

# ── Model Weights Path ────────────────────────────────────────────────────
MODEL_WEIGHTS_PATH=/opt/lingua-seeker-data/models

# ── GPU Memory Allocation ─────────────────────────────────────────────────
EMBEDDING_GPU_MEM=0.15
RERANK_GPU_MEM=0.15
DOC_PARSE_GPU_MEM=0.60

# ── LLM Endpoints (SiliconFlow / OpenAI-compatible) ──────────────────────
FAST_LLM_BASE_URL=https://linxi.chat/v1
FAST_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

REASONING_LLM_BASE_URL=https://linxi.chat/v1
REASONING_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

CHAT_LLM_BASE_URL=https://api.siliconflow.cn
CHAT_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

TRANSLATION_LLM_BASE_URL=https://api.siliconflow.cn
TRANSLATION_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Literature Acquisition ────────────────────────────────────────────────
UNPAYWALL_EMAIL=admin@your-domain.com
PUBMED_API_KEY=

# ── MinerU ────────────────────────────────────────────────────────────────
MINERU_API_TOKEN=
