# Frontend host environment — copy to .env, fill in, never commit.

FRONTEND_IMAGE=ghcr.io/lanshi17/lingua-seeker-frontend
IMAGE_TAG=latest

# Public listen port for this host. Front with a TLS terminator (system
# nginx / Caddy / load balancer) bound to 443.
FRONTEND_PORT=80

# SPA mount path — leave empty/"/" for root, set "/linguaseeker" for subpath.
# Build-time (VITE_BASE_PATH, baked into bundle) and runtime (BASE_PATH,
# nginx location prefixes) default to the same value; override separately
# only if you rebuild with a different mount than you serve at.
VITE_BASE_PATH=/linguaseeker
BASE_PATH=/linguaseeker

# ── Cross-host wiring ────────────────────────────────────────────────────
# Backend host's reachable address (private IP recommended). MUST be
# whitelisted by the backend host's firewall.
BACKEND_URL=http://10.0.0.20:8000

# Shared with backend host (deploy/compose/backend-host/.env::API_KEY).
API_KEY=change-me-to-a-long-random-string

# Upload size cap; matches backend MINERU_MAX_FILE_SIZE_MB.
FRONTEND_MAX_BODY=200m
