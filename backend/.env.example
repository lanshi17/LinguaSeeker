# ==================== 应用配置 ====================
APP_NAME="ACMG-Lingua"
APP_VERSION="3.0.0"
API_PREFIX="/api/v1"
CORS_ORIGINS="*"
ENVIRONMENT="development"
DEBUG="false"
API_HOST="localhost"
API_PORT="8000"

# ==================== 智能体配置 ====================

#文献获取智能体 (OpenAI兼容格式)
RETRIEVAL_API_KEY="your-retrieval-api-key"
RETRIEVAL_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
RETRIEVAL_MODEL="qwen3.5-flash"

#文档解析智能体 (OpenAI兼容格式)
PARSING_API_KEY="your-parsing-api-key"
PARSING_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
PARSING_MODEL="qwen3.5-flash"

#多语种翻译智能体 (OpenAI兼容格式)
MT_API_KEY="your-mt-api-key"
MT_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
MT_MODEL="qwen-mt-flash"

#多功能排版智能体 (OpenAI兼容格式)
FORMAT_API_KEY="your-format-api-key"
FORMAT_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
FORMAT_MODEL="qwen3.5-flash"

#图片提取智能体 (OpenAI兼容格式)
VLM_API_KEY="your-vlm-api-key"
VLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
VLM_MODEL="qwen3-vl-flash"
VLM_ENABLE="false"

#证据提取智能体(OpenAI兼容格式)
EVIDENCE_API_KEY="your-evidence-api-key"
EVIDENCE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
EVIDENCE_MODEL="qwen3.5-plus"

#ACMG分类智能体 (OpenAI兼容格式)
CLASSIFICATION_API_KEY="your-classification-api-key"
CLASSIFICATION_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
CLASSIFICATION_MODEL="qwen3.5-plus"

#专家裁决智能体 (OpenAI兼容格式)
ARBITRATION_API_KEY="your-arbitration-api-key"
ARBITRATION_MODEL="qwen3-max"
ARBITRATION_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# LLM通用配置
LLM_TEMPERATURE="0"
LLM_MAX_TOKENS="2000"
LLM_TIMEOUT="60"
LLM_MAX_RETRIES="3"

# 调用模式（保留用于本地部署）
LLM_MODE="api"

# ==================== Embedding配置 ====================
EMBEDDING_PROVIDER="qwen"
EMBEDDING_API_KEY="your-embedding-api-key"
EMBEDDING_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
EMBEDDING_MODEL="text-embedding-v4"
EMBEDDING_DIMENSION="1536"
EMBEDDING_BATCH_SIZE="10"

#===================== Rerank配置 ====================
RERANK_API_KEY="your-rerank-api-key"
RERANK_BASE_URL="https://dashscope.aliyuncs.com/compatible-api/v1/reranks"
RERANK_MODEL="qwen3-rerank"
RERANK_TOP_K="10"
RERANK_SCORE_THRESHOLD="0.7"

# ==================== MinerU 配置 ====================
MINERU_MODE="api"
MINERU_API_URL="https://mineru.net/api/v4"
MINERU_API_TOKEN="your-mineru-api-token"
MINERU_API_TOKEN_BACKUP="your-mineru-backup-api-token"
MINERU_VERSION="vlm"
MINERU_DOWNLOAD_DIR="./tmp/mineru_downloads"
MINERU_TIMEOUT="300"
MINERU_MAX_FILE_SIZE_MB="100"

# ==================== Redis配置 (local) ====================
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD="your-redis-password"
REDIS_DB="0"
REDIS_MAX_CONNECTIONS="20"

# ==================== PostgreSQL配置 (local) ====================
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT="5432"
POSTGRES_DB="acmg_ps3"
POSTGRES_SCHEMA="acmg_app"
POSTGRES_USER="acmg_user"
POSTGRES_PASSWORD="your-postgres-password"
POSTGRES_POOL_SIZE="20"
POSTGRES_MAX_OVERFLOW="30"

# ==================== Neo4j配置 (local) ====================
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your-neo4j-password"
NEO4J_DATABASE="neo4j"
NEO4J_MAX_CONNECTION_LIFETIME="3600"
NEO4J_MAX_CONNECTION_POOL_SIZE="50"

# ==================== 向量数据库选择 ====================
VECTOR_DB="qdrant"
KNOWLEDGE_DOCS_DIR="./knowledge_docs"

# ==================== Qdrant配置 (local) ====================
QDRANT_HOST="localhost"
QDRANT_PORT="6333"
QDRANT_HTTPS="true"
QDRANT_COLLECTION_NAME="acmg_paper_chunks"
QDRANT_API_KEY="your-qdrant-api-key"
QDRANT_DIMENSION="1536"
QDRANT_VERIFY_SSL="false"
QDRANT_PREFER_GRPC="false"

# ==================== Milvus配置 (可选，备用) ====================
MILVUS_HOST="milvus.example.com"
MILVUS_PORT="19530"
MILVUS_COLLECTION_NAME="acmg_paper_chunks"
MILVUS_DIMENSION="1536"
MILVUS_INDEX_TYPE="IVF_FLAT"
MILVUS_METRIC_TYPE="L2"

# ==================== MinIO配置 (默认使用本地HTTPS) ====================
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="your-minio-access-key"
MINIO_SECRET_KEY="your-minio-secret-key"
MINIO_API="s3v4"
MINIO_PATH="auto"
MINIO_BUCKET_NAME="acmg-bucket"
# 本地MinIO默认使用HTTPS，如需HTTP可显式将其改为"false"
MINIO_SECURE="false"
MINIO_ROOT_USER="your-minio-root-user"
MINIO_ROOT_PASSWORD="your-minio-root-password"

# ==================== 任务配置 ====================
MAX_REASONING_ITERATIONS="3"
TASK_TIMEOUT_SECONDS="3600"

# ==================== 文献获取配置 ====================
PUBMED_API_KEY="your-pubmed-api-key"
PUBMED_BASE_URL="https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi"
UNPAYWALL_EMAIL="your-email@example.com"
JSTAGE_PROXY="http://127.0.0.1:7890"
# CRAWL4AI_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
# CRAWL4AI_API_KEY="your-crawl4ai-api-key"
# CRAWL4AI_MODEL="qwen3.5-flash"

#=====================SMTP 邮箱配置==================
SMTP_HOST="smtp.exmail.qq.com"
SMTP_PORT="465"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM_EMAIL="your-email@example.com"
