{# ============================================================================
   Rendered Configuration Template
   ============================================================================
   Merges layered variables (defaults -> environment -> vault) into the flat
   key format expected by backend/src/core/config.py.
   
   Render via: scripts/render_config.py or the config loader in config.py
   Output:     backend/config-dev.yaml (git-ignored) or stdout
   ============================================================================ #}
# Auto-generated configuration — DO NOT EDIT MANUALLY
# Generated from: defaults/main.yaml + environments/{{ environment }}.yaml + vault/{{ environment }}.yaml
# Regenerate with: uv run python scripts/render_config.py --env {{ environment }}

# ── App ──────────────────────────────────────────────────────────────────
cors_origins: "{{ cors_origins }}"
environment: {{ environment }}
debug: {{ debug | lower }}

# ── Fast LLM (OpenAI-compatible) ────────────────────────────────────────
fast_llm:
  api_key: {{ fast_llm.api_key | default('') }}
  base_url: {{ fast_llm.base_url | default('') }}
  model: {{ fast_llm.model }}
  timeout: {{ fast_llm.timeout }}

# ── Reasoning LLM ───────────────────────────────────────────────────────
reasoning_llm:
  api_key: {{ reasoning_llm.api_key | default('') }}
  model: {{ reasoning_llm.model }}
  reasoning_effort: {{ reasoning_llm.reasoning_effort }}
  base_url: {{ reasoning_llm.base_url | default('') }}
  timeout: {{ reasoning_llm.timeout }}

# ── Embedding (local model-server) ──────────────────────────────────────
embedding:
  base_url: {{ embedding.base_url | default('') }}
  model: {{ embedding.model }}
  dimension: {{ embedding.dimension }}
  batch_size: {{ embedding.batch_size }}

# ── Rerank (local model-server) ─────────────────────────────────────────
rerank:
  base_url: {{ rerank.base_url | default('') }}
  model: {{ rerank.model }}
  top_k: {{ rerank.top_k }}
  score_threshold: {{ rerank.score_threshold }}

# ── MinerU document parsing ─────────────────────────────────────────────
mineru:
  max_file_size_mb: {{ mineru.max_file_size_mb }}
  api_token: {{ mineru.api_token | default('') }}
  api_token_backup: {{ mineru.api_token_backup | default('') }}
  remote_api_token: {{ mineru.remote_api_token | default('') }}
  remote_poll_interval: {{ mineru.remote_poll_interval }}
  remote_max_poll_attempts: {{ mineru.remote_max_poll_attempts }}
  local_model_server_url: {{ mineru.local_model_server_url }}
  local_model_id: {{ mineru.local_model_id }}
  local_timeout: {{ mineru.local_timeout }}
  local_dpi: {{ mineru.local_dpi }}

# ── Model Server ────────────────────────────────────────────────────────
model_server_url: http://{{ api_host if api_host != '0.0.0.0' else 'localhost' }}:{{ model_server_port | default(8001) }}

# ── Redis ───────────────────────────────────────────────────────────────
redis:
  host: {{ redis.host }}
  port: {{ redis.port }}
  password: "{{ redis.password | default('') }}"
  db: {{ redis.db }}
  max_connections: {{ redis.max_connections }}

# ── PostgreSQL ──────────────────────────────────────────────────────────
postgres:
  host: {{ postgres.host | default('127.0.0.1') }}
  port: {{ postgres.port }}
  db: {{ postgres.db | default('acmg_lingua') }}
  schema: {{ postgres.schema | default('acmg_app') }}
  user: {{ postgres.user | default('') }}
  password: {{ postgres.password | default('') }}
  pool_size: {{ postgres.pool_size }}
  max_overflow: {{ postgres.max_overflow }}

# ── Web Search ──────────────────────────────────────────────────────────
web_search:
  api_key: {{ web_search.api_key | default('') }}
  base_url: {{ web_search.base_url }}
  timeout: {{ web_search.timeout }}
  max_results: {{ web_search.max_results }}

# ── Network / Proxy ────────────────────────────────────────────────────
network:
  proxy: {{ network.proxy | default('') }}
  no_proxy: "{{ network.no_proxy | default('') }}"

# ── Evidence Extraction ────────────────────────────────────────────────
evidence_extraction:
  api_key: {{ evidence_extraction.api_key | default('') }}
  base_url: {{ evidence_extraction.base_url | default('') }}
  reasoning_api_key: {{ evidence_extraction.reasoning_api_key | default('') }}
  reasoning_base_url: {{ evidence_extraction.reasoning_base_url | default('') }}
  fast_model: {{ evidence_extraction.fast_model | default('') }}
  standard_model: {{ evidence_extraction.standard_model | default('') }}
  strong_model: {{ evidence_extraction.strong_model | default('') }}
  fast_effort: {{ evidence_extraction.fast_effort | default('') }}
  standard_effort: {{ evidence_extraction.standard_effort | default('') }}
  strong_effort: {{ evidence_extraction.strong_effort | default('high') }}
  temperature: {{ evidence_extraction.temperature }}
  timeout: {{ evidence_extraction.timeout }}
  max_retries: {{ evidence_extraction.max_retries }}

# ── Model Server GPU settings ──────────────────────────────────────────
vlm_model_id: "{{ vlm_model_id | default('') }}"
embedding_gpu_memory_utilization: {{ embedding_gpu_memory_utilization | default(0.35) }}
embedding_max_model_len: {{ embedding_max_model_len | default(4096) }}
rerank_gpu_memory_utilization: {{ rerank_gpu_memory_utilization | default(0.2) }}
vlm_gpu_memory_utilization: {{ vlm_gpu_memory_utilization | default(0.5) }}
