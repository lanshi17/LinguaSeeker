# ═══════════════════════════════════════════════════════════
# Layer 1: Safe defaults — committed to git.
# Override via .env.development, .env.local, or OS env vars.
# ═══════════════════════════════════════════════════════════

# ─── App ───
VITE_APP_NAME=ACMG Lingua
VITE_APP_VERSION=1.0.0

# ─── API ───
# Relative URL → goes through the Vite dev-server proxy (see vite.config.ts).
# Do NOT set to http://localhost:8000/api/v1 — use the proxy.
VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT=30000
VITE_HEALTH_ENDPOINT=/health
VITE_HEALTH_POLL_INTERVAL=30000

# ─── Feature Flags ───
VITE_ENABLE_CHAT=true
VITE_ENABLE_GRAPH=true
